---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import type { AboutProps, HeroProps } from "@types";

type Props = AboutProps & Pick<HeroProps, "name">;

const { description, image, name } = Astro.props;
---

<Section text="About Me" href="about">
  <div
    class="flex flex-col items-center gap-12 md:flex-row md:items-start md:gap-12"
  >
    <div class="w-full text-base leading-8 text-neutral md:flex-1">
      {
        description
          .split("\n")
          .map((paragraph) => <p class="mb-6 last:mb-0">{paragraph.trim()}</p>)
      }
    </div>

    <div
      class="h-80 w-64 shrink-0 rotate-[3deg] rounded-sm bg-white p-4 shadow-md ring-1 ring-primary/10 md:rotate-[5deg]"
    >
      <Image
        class="h-full w-full rounded-sm object-cover"
        src={image}
        width="260"
        height="260"
        alt={`${name} - Computer Science student`}
      />
    </div>
  </div>
</Section>
