---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import type { ProjectProps } from "@types";

interface Props {
  projects: ProjectProps[];
}

const { projects } = Astro.props;
---

<Section text="Featured Projects" href="projects">
  <div class="space-y-8">
    {
      projects.map(
        (
          { name, summary, image, technologies, linkPreview, linkSource },
          index,
        ) => (
          <article class="overflow-hidden rounded-2xl border border-primary/15 bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg">
            <div class="grid md:grid-cols-2">
              {/* Project information */}
              <div class="flex flex-col justify-center p-7 md:p-10">
                <span class="mb-3 text-sm font-medium text-primary">
                  Project {String(index + 1).padStart(2, "0")}
                </span>

                <h3 class="mb-4 font-serif text-3xl font-bold tracking-tight text-black">
                  {name}
                </h3>

                <p class="mb-6 max-w-xl text-base leading-7 text-neutral">
                  {summary}
                </p>

                {/* Technologies */}
                <div class="mb-7 flex flex-wrap gap-2">
                  {technologies.map((technology) => (
                    <span class="rounded-full bg-[#f8f5fc] px-3 py-1.5 text-xs font-medium text-primary">
                      {technology}
                    </span>
                  ))}
                </div>

                {/* Links */}
                <div class="flex flex-wrap gap-3">
                  {linkSource && (
                    <a
                      href={linkSource}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="rounded-full bg-primary px-6 py-3 text-sm font-medium text-white transition hover:opacity-90"
                    >
                      GitHub
                    </a>
                  )}

                  {linkPreview && (
                    <a
                      href={linkPreview}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="rounded-full border border-primary px-6 py-3 text-sm font-medium text-primary transition hover:bg-primary hover:text-white"
                    >
                      Live Demo
                    </a>
                  )}
                </div>
              </div>

              {/* Project image */}
              <div class="flex min-h-72 items-center justify-center bg-[#f8f5fc] p-6 md:min-h-96">
                {image && (
                  <Image
                    class="max-h-80 w-full rounded-xl object-cover object-top shadow-sm"
                    src={image}
                    alt={`${name} project screenshot`}
                    width="736"
                    height="483"
                  />
                )}
              </div>
            </div>
          </article>
        ),
      )
    }
  </div>
</Section>