---
import type { SiteConfig } from "@types";

type Props = Pick<SiteConfig, "author" | "socialLinks">;

const { author, socialLinks } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer
  class="mt-20 w-full border-t border-primary/15 bg-[#f8f5fc] px-5 pt-12 pb-8"
>
  <div class="mx-auto max-w-5xl text-center">
    <h2 class="mb-3 font-serif text-3xl font-bold text-black">
      Let's Connect
    </h2>

    <p class="mx-auto mb-8 max-w-xl text-sm leading-6 text-neutral">
      I'm always open to opportunities to learn, collaborate, and contribute
      to meaningful technology projects.
    </p>

    <div class="mb-10 flex flex-wrap justify-center gap-3">
      {
        socialLinks.map(({ text, href }) => (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full border border-primary/20 bg-white px-6 py-3 text-sm font-medium text-black transition hover:border-primary hover:bg-primary hover:text-white"
          >
            {text}
          </a>
        ))
      }

      <a
        href="mailto:rejoice.teca@gmail.com"
        class="rounded-full bg-primary px-6 py-3 text-sm font-medium text-white transition hover:opacity-90"
      >
        Email Me
      </a>
    </div>

    <div class="border-t border-primary/10 pt-6">
      <p class="text-xs text-neutral">
        © {currentYear} {author}. All rights reserved.
      </p>
    </div>
  </div>
</footer>