---
import Section from "./Section.astro";
import type { ExperienceProps } from "@types";

interface Props {
  experience: ExperienceProps[];
}

const { experience } = Astro.props;
---

<Section text="Education & Experience" href="experience">
  <div class="space-y-10">
    {
      experience.map(({ company, position, startDate, endDate, summary }) => (
        <article class="relative border-l-2 border-primary/20 pl-6 md:pl-8">
          <div class="absolute top-1.5 -left-2.25 h-4 w-4 rounded-full border-4 border-white bg-primary" />

          <div class="mb-5">
            <h3 class="mb-2 font-serif text-2xl font-semibold text-black">
              {company}
            </h3>

            <h4 class="mb-1 font-serif text-xl font-medium text-primary">
              {position}
            </h4>

            <span class="text-sm font-medium text-neutral">
              {startDate} — {endDate}
            </span>
          </div>

          {Array.isArray(summary) ? (
            <ul class="space-y-3">
              {summary.map((item) => (
                <li class="relative pl-6 text-base leading-7 text-neutral before:absolute before:top-3 before:left-0 before:h-1.5 before:w-1.5 before:rounded-full before:bg-primary">
                  {item}
                </li>
              ))}
            </ul>
          ) : (
            <p class="text-base leading-7 text-neutral">{summary}</p>
          )}
        </article>
      ))
    }
  </div>
</Section>
